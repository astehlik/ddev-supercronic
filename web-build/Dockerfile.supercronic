#ddev-generated
ARG SUPERCRONIC_VERSION=v0.2.47
ARG SUPERCRONIC_SHA1SUM_AMD64=712d2ece75da6f6e530192a151488578153e4e96
ARG SUPERCRONIC_SHA1SUM_ARM64=93323899ddca3f1198f1796a4bf4418ed1e7982e

ARG TARGETARCH
RUN set -eux; \
    case "${TARGETARCH}" in \
        amd64) SHA="${SUPERCRONIC_SHA1SUM_AMD64}" ;; \
        arm64) SHA="${SUPERCRONIC_SHA1SUM_ARM64}" ;; \
        *) echo "Unsupported architecture: ${TARGETARCH}" && exit 1 ;; \
    esac; \
    curl -fsSL "https://github.com/aptible/supercronic/releases/download/${SUPERCRONIC_VERSION}/supercronic-linux-${TARGETARCH}" \
        -o /usr/local/bin/supercronic \
    && echo "${SHA}  /usr/local/bin/supercronic" | sha1sum -c - \
    && chmod +x /usr/local/bin/supercronic

RUN mkdir -p /etc/supercronic
COPY ./*.cron /etc/supercronic/
RUN cat /etc/supercronic/*.cron > /etc/supercronic/crontab

COPY ./supercronic.conf /etc/supervisor/conf.d/supercronic.conf
